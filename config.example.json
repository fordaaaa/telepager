{
  "bot_token": "123456:ABC-DEF-your-token-from-BotFather",
  "allowed_user_ids": [123456789],

  "master": {
    "provider": "claude-code",

    "bundled_mcp": true,

    "tmux_attach": false,

    "mcp_servers": {
      "my-server": {
        "type": "stdio",
        "command": "my-mcp",
        "args": []
      }
    }
  },

  "allowed_dirs": [],

  "agents": {
    "mine": {
      "command": "my-agent",
      "args": ["--prompt", "{task}"],
      "model_args": ["--model", "{model}"],
      "description": "shows up in the console's agent picker"
    }
  }
}
